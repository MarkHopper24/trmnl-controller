    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "bundle:plugin": "node scripts/bundle-plugin.mjs",
    "smoke": "node scripts/smoke.mjs",
    "spec:update": "node scripts/update-spec.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "fflate": "^0.8.3",
