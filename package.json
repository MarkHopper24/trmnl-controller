    "parse5": "^8.0.1",
    "undici": "^8.12.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "homepage": "https://github.com/MarkHopper24/trmnl-controller",
