{
  "name": "trmnl-controller-mcp",
  "version": "0.2.0",
  "description": "TRMNL Controller: local Codex plugin, documented API tools and deterministic data pipelines.",
  "type": "module",
  "bin": {
    "trmnl-controller": "src/cli.mjs",
    "trmnl-control": "src/cli.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "specs/trmnl.openapi.json",
    "specs/source.json",
    "docs",
    "README.md",
    "LICENSE",
    "config.example.json",
    "plugin/assets"
  ],
  "scripts": {
